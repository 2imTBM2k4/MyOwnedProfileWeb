# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Get your project URL and keys from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Server-side service role key (for administrative operations & private CV storage)
# NEVER expose this key to the browser!
SUPABASE_SECRET_KEY=your-service-role-secret-key-here

# ==============================================================================
# Admin Dashboard Authentication (/admin)
# ==============================================================================
# Strong password for signing in to the /admin CMS panel
ADMIN_PASSWORD=your-super-secure-admin-password

# ==============================================================================
# Contact Form & Email Delivery (Resend API)
# ==============================================================================
# Get your free API key at https://resend.com/api-keys (3,000 free emails/month)
RESEND_API_KEY=re_your_resend_api_key_here

# Recipient email address where contact messages will be delivered
CONTACT_TO_EMAIL=2004.tranbinhminh@gmail.com

# Sender email address (default testing sender is onboarding@resend.dev)
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ==============================================================================
# Integrations (Gaming, Discord, HoYoLAB)
# ==============================================================================
# Steam Web API Key (Get at: https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your-steam-web-api-key

# Discord ID for Lanyard status integration
# Enable Developer Mode in Discord → Right-click user avatar → Copy User ID
NEXT_PUBLIC_DISCORD_ID=your-discord-user-id

# RAWG Video Games Database API Key (Get free key at: https://rawg.io/apidocs)
RAWG_API_KEY=your-rawg-api-key

# HoYoLAB credentials (Optional: for live Genshin/Honkai stats)
HOYOLAB_LTOKEN=your-hoyolab-ltoken
HOYOLAB_LTUID=your-hoyolab-ltuid
